/* pages/index/index.wxss */

.container {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f0f7ff 0%, #f5f5f5 100%);
}

/* 头部样式 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
}

.logo {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 6rpx;
  display: block;
  flex-shrink: 0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1296db;
  display: block;
}

.subtitle {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

/* 日期选择区域 */
.date-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  width: 100%;
  box-sizing: border-box;
}

.date-section picker {
  display: block;
  width: 100%;
  margin-bottom: 12rpx;
}

.date-picker-touchable {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #eef2f7 100%);
  border-radius: 16rpx;
  border: 2rpx solid #e8eef5;
  transition: all 0.2s ease;
}

.date-picker-hover {
  background: linear-gradient(135deg, #eef2f7 0%, #e4eaf2 100%);
  border-color: #d0dae5;
}

.date-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.date-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c3e50;
  flex: 1;
  text-align: center;
  letter-spacing: 2rpx;
}

.date-arrow {
  font-size: 22rpx;
  color: #7f8c9a;
  margin-left: 10rpx;
}

.quick-buttons {
  /* 直接居中定位 */
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 10rpx;
  width: 100%;
}

.quick-btn {
  /* 重置微信小程序按钮默认样式 */
  margin: 0 !important; /* 使用 !important 确保覆盖默认样式 */
  padding: 0 !important;
  border: none !important;
  background: none !important;
  font-size: 26rpx !important;
  /* 自定义按钮样式 */
  width: 140rpx !important;
  height: 70rpx !important;
  line-height: 70rpx !important;
  color: #fff !important;
  border-radius: 20rpx !important; /* 统一圆角风格，与下方卡片一致 */
  text-align: center !important;
  flex: 0 0 auto;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15); /* 添加阴影效果 */
  transition: all 0.3s ease; /* 添加过渡效果 */
}

.quick-btn::after {
  /* 完全移除按钮的默认伪元素 */
  content: none !important;
}

/* 确保按钮点击区域正常工作 */
.quick-btn {
  touch-action: manipulation;
}

/* 最新按钮 - 低饱和度灰蓝渐变 */
.btn-latest {
  background: linear-gradient(135deg, #7a9eb8, #5c849e) !important;
}

.btn-latest:active {
  background: linear-gradient(135deg, #5c849e, #4a7088) !important;
  box-shadow: 0 2rpx 8rpx rgba(122, 158, 184, 0.3) !important;
}

/* 前一天按钮 - 低饱和度sage绿渐变 */
.btn-previous {
  background: linear-gradient(135deg, #8ab89e, #6a9e82) !important;
}

.btn-previous:active {
  background: linear-gradient(135deg, #6a9e82, #548a6c) !important;
  box-shadow: 0 2rpx 8rpx rgba(138, 184, 158, 0.3) !important;
}

/* 后一天按钮 - 低饱和度暖橙渐变 */
.btn-next {
  background: linear-gradient(135deg, #c8a07a, #b08a64) !important;
}

.btn-next:active {
  background: linear-gradient(135deg, #b08a64, #9a7654) !important;
  box-shadow: 0 2rpx 8rpx rgba(200, 160, 122, 0.3) !important;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}

.tab-item-wrapper {
  flex: 1;
  position: relative;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tab-item.active {
  background: linear-gradient(135deg, #b8a5c4, #9c89a8);
  color: #fff;
  font-weight: 500;
}

.dropdown-icon {
  font-size: 20rpx;
  color: #fff;
  transition: transform 0.3s ease;
  opacity: 0.8;
}

.dropdown-icon.expanded {
  transform: rotate(180deg);
}

/* 下拉菜单遮罩 */
.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 998;
  background: transparent;
}

/* 下拉菜单 */
.daily-average-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  margin-top: 8rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
  z-index: 999;
  opacity: 0;
  transform: translateY(-10rpx);
  pointer-events: none;
  transition: all 0.3s ease;
  overflow: hidden;
}

.daily-average-dropdown.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.dropdown-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  transition: background-color 0.2s;
}

.dropdown-item:active {
  background-color: #f5f5f5;
}

.dropdown-item:not(:last-child) {
  border-bottom: 1rpx solid #f0f0f0;
}

.dropdown-item-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.dropdown-item-text {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.dropdown-item.selected {
  background-color: #f0f0f5;
}

.dropdown-item.selected .dropdown-item-text {
  color: #1296db;
  font-weight: 500;
}

/* 日均数据内容区域 */
.daily-average-content {
  animation: fadeIn 0.3s ease;
  margin-bottom: 20rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #1296db;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}

/* 错误提示 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 30rpx;
  color: #999;
}

/* 数据展示区域 */
.data-container {
  width: 100%;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 基本信息卡片 */
.info-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-item {
  flex: 1;
  text-align: center;
  min-width: 0;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.info-value {
  font-size: 32rpx;
  color: #000;
  font-weight: 700;
}

/* 总客流卡片 - 低饱和度蓝灰渐变 */
.total-card {
  background: linear-gradient(135deg, #7a9eb8, #5c849e);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(122, 158, 184, 0.25);
  width: 100%;
  box-sizing: border-box;
}

.total-card-split {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 0;
}

.total-card-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.total-card-item.metro-only {
  padding-right: 20rpx;
}

.total-card-item.total-all {
  padding-left: 20rpx;
}

.total-card-divider {
  width: 2rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
  flex-shrink: 0;
}

.total-item-label {
  font-size: 30rpx;
  color: #fff;
  display: block;
  margin-bottom: 20rpx;
  font-weight: 700;
}

.total-item-value-wrapper {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex-wrap: nowrap;
}

.total-item-value {
  font-size: 64rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
  white-space: nowrap;
}

.total-item-unit {
  font-size: 28rpx;
  color: #fff;
  margin-left: 8rpx;
  white-space: nowrap;
  font-weight: 600;
}

/* 日均客流卡片 */
.average-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}

.average-card.average-loading {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  gap: 16rpx;
}

.average-loading-inline {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 50rpx 30rpx;
  gap: 16rpx;
}

.loading-spinner.small {
  width: 32rpx;
  height: 32rpx;
  border-width: 3rpx;
}

.average-loading-text {
  font-size: 26rpx;
  color: #999;
}

.average-section {
  padding: 16rpx 0;
}

.average-section:first-child {
  padding-top: 0;
}

.average-section:last-child {
  padding-bottom: 0;
}

.average-section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.average-section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.average-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.average-section-days {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.average-section-content {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
}

.average-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.average-item-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.average-item-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #1e293b;
  line-height: 1.2;
}

.average-item-unit {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.average-item-divider {
  width: 2rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent, #cbd5e1, transparent);
  margin: 0 20rpx;
  flex-shrink: 0;
}

.average-card-divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
  margin: 10rpx 0;
}

.average-section-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.average-empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 兼容旧样式（用于模态框等） */
.total-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-bottom: 15rpx;
}

.total-value-wrapper {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.total-value {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
}

.total-unit {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 10rpx;
}

/* 图表卡片 */
.chart-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.chart-unit {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.save-btn {
  padding: 10rpx 24rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.chart-container {
  width: 100%;
  position: relative;
  overflow: visible;
  background: #fff;
}

.bar-chart-container {
  height: 350rpx;
  position: relative;
}

/* 全屏提示图标 */
.fullscreen-hint {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.7;
  transition: opacity 0.2s;
}

.fullscreen-hint:active {
  opacity: 1;
}

.fullscreen-icon {
  font-size: 28rpx;
  color: #fff;
}

.line-chart-container {
  height: 400rpx;
}

.month-line-chart-container {
  height: 450rpx;
}

.compare-chart-container {
  height: 450rpx;
}

.chart-canvas {
  display: block;
  background: transparent;
}

.bar-canvas {
  width: 690rpx;
  height: 350rpx;
}

.bar-canvas-full {
  width: 690rpx;
  height: 520rpx;
}

.line-canvas {
  width: 690rpx;
  height: 400rpx;
}

.month-line-canvas {
  width: 690rpx;
  height: 450rpx;
}

.week-bar-canvas {
  width: 690rpx;
  height: 350rpx;
}

.week-bar-chart-container {
  height: 350rpx;
}

.compare-canvas {
  width: 690rpx;
  height: 450rpx;
}

.chart-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 20rpx;
}

.footer-logo {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
  opacity: 0.6;
  display: block;
  flex-shrink: 0;
}

.footer-text {
  font-size: 22rpx;
  color: #999;
}

/* 柱状图放大查看 */
.chart-fullscreen-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.chart-fullscreen-content {
  width: 94%;
  max-width: 750rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 20rpx 20rpx;
}

.chart-fullscreen-close-icon {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 36rpx;
  color: #666;
  background: rgba(0,0,0,0.06);
  border-radius: 50%;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.08);
  z-index: 2;
}

.chart-fullscreen-close-icon:active {
  background: rgba(0,0,0,0.12);
}

/* 纯地铁客流标题样式 */
.metro-only-title-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 20rpx 20rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}

.metro-only-title-section::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
  animation: shimmer 3s infinite;
}

@keyframes shimmer {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.metro-only-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  margin-bottom: 12rpx;
}

.metro-only-icon {
  font-size: 28rpx;
}

.metro-only-label {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}

.metro-only-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.metro-only-value {
  font-size: 72rpx;
  font-weight: 800;
  color: #fff;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.3);
  letter-spacing: -2rpx;
}

.metro-only-unit {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 600;
}

.metro-only-date {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

/* 隐藏的保存canvas */
.save-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 350px;
  height: 500px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.chart-fullscreen-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
  padding: 0 10rpx;
}

.chart-fullscreen-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.chart-fullscreen-subtitle {
  font-size: 24rpx;
  color: #999;
}

.chart-fullscreen-body {
  padding: 10rpx;
}

.chart-fullscreen-close {
  margin-top: 10rpx;
  align-self: center;
  padding: 10rpx 40rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1296db, #0d7ab5);
  color: #fff;
  font-size: 26rpx;
}

/* 线路列表 */
.line-list {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}

.line-list-header {
  margin-bottom: 30rpx;
}

.line-list-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.line-list-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.line-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.line-item:last-child {
  margin-bottom: 0;
}

.line-info {
  width: 140rpx;
  min-width: 120rpx;
  flex-shrink: 0;
}

.line-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  min-width: 120rpx;
}

.line-name {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

.line-bar-wrapper {
  flex: 1;
  height: 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.line-bar {
