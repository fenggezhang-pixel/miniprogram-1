}

.modal-content {
  width: 90%;
  max-width: 700rpx;
  height: 80vh;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: slideUp 0.3s ease;
  box-sizing: border-box;
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fff;
  position: relative;
  flex-shrink: 0;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
  cursor: pointer;
  border-radius: 50%;
  transition: background-color 0.2s;
}

.modal-close:active {
  background-color: #f5f5f5;
}

.modal-body {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  min-height: 0; /* 确保flex子元素可以正确收缩 */
  width: 100%;
}

/* 弹窗内的总客流卡片去掉阴影 */
.modal-body .total-card {
  box-shadow: none;
  margin-bottom: 30rpx;
}

/* 版本更新提示弹窗样式 */
.version-tip-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  animation: fadeIn 0.3s ease;
}

.version-tip-modal {
  width: 560rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f8f9ff 100%);
  border-radius: 32rpx;
  padding: 60rpx 40rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(102, 126, 234, 0.25);
  animation: popIn 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

@keyframes popIn {
  0% {
    transform: scale(0.8);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.version-tip-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
  animation: bounce 1s ease infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-15rpx);
  }
}

.version-tip-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.version-tip-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 30rpx;
  width: 100%;
}

.version-tip-item {
  font-size: 30rpx;
  color: #555;
  line-height: 1.6;
  padding-left: 20rpx;
}

.version-tip-hint-item {
  font-size: 28rpx;
  color: #1296db;
  line-height: 1.6;
  padding: 16rpx 20rpx;
  background: #f0f7ff;
  border-radius: 12rpx;
  border-left: 4rpx solid #1296db;
  margin-top: 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.version-tip-note {
  font-size: 24rpx;
  color: #999;
  padding-left: 60rpx;
  margin-top: -8rpx;
}

.version-tip-update-hint {
  font-size: 22rpx;
  color: #ff9500;
  background: #fff8e6;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  margin-top: 10rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.version-tip-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 生成长图按钮区域 */
.generate-image-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  margin-top: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.generate-image-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #8fa4b8 0%, #a3b5c7 50%, #9aacbe 100%);
  border-radius: 48rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(143, 164, 184, 0.35);
}

.generate-image-btn::after {
  border: none;
}

.generate-image-btn[disabled] {
  background: linear-gradient(135deg, #c5c5c5 0%, #b8b8b8 100%);
  box-shadow: none;
}

.generate-image-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

.generate-image-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 隐藏的长图canvas */
.long-image-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 750rpx;
  height: 2000rpx;
}