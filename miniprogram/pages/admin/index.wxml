<!--pages/admin/index.wxml-->
<view class="admin-container">
  <view class="admin-header">
    <text class="admin-title">数据管理</text>
    <text class="admin-subtitle">手动录入微博数据</text>
  </view>

  <!-- 密码验证（首次访问） -->
  <view class="password-section" wx:if="{{!isAuthenticated}}">
    <view class="password-input-wrapper">
      <text class="password-label">请输入管理密码：</text>
      <input 
        class="password-input" 
        type="password" 
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordInput"
        password
      />
      <button class="password-btn" bindtap="checkPassword">确认</button>
    </view>
  </view>

  <!-- 数据录入界面（已认证） -->
  <view class="input-section" wx:else>
    <view class="input-card">
      <view class="input-label">
        <text class="label-text">微博文本：</text>
        <text class="label-hint">（粘贴完整的微博文本内容）</text>
      </view>
      <textarea 
        class="weibo-textarea" 
        placeholder="请粘贴微博文本，例如：#早安成都#1月14日，成都地铁客运量800.00万人次、市域（郊）铁路客运量3.35万人次、有轨电车客运量3.00万人次，线网运营平稳有序。今日周三，搭乘地铁便捷出行，早安。3-11，晴。"
        value="{{weiboText}}"
        bindinput="onWeiboTextInput"
        maxlength="500"
        show-confirm-bar="{{false}}"
        auto-height
      />
      
      <button 
        class="submit-btn" 
        bindtap="submitData"
        disabled="{{submitting || !canSubmit}}"
      >
        <text wx:if="{{submitting}}">提交中...</text>
        <text wx:else>提交数据</text>
      </button>
    </view>

    <!-- 提交结果 -->
    <view class="result-card" wx:if="{{submitResult}}">
      <view class="result-header {{submitResult.success ? 'success' : 'error'}}">
        <text class="result-icon">{{submitResult.success ? '✅' : '❌'}}</text>
        <text class="result-title">{{submitResult.success ? '提交成功' : '提交失败'}}</text>
      </view>
      <view class="result-content">
        <text class="result-message">{{submitResult.message}}</text>
        <text class="result-detail" wx:if="{{submitResult.data}}">
          日期：{{submitResult.data.date}}<text wx:if="{{submitResult.data.totalPassenger}}">\n总客流：{{submitResult.data.totalPassenger}}万人次</text>
        </text>
      </view>
    </view>
  </view>
</view>
