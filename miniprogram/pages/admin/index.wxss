/* pages/admin/index.wxss */
.admin-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f9ff 0%, #e0f2fe 100%);
  padding: 40rpx 30rpx;
}

.admin-header {
  text-align: center;
  margin-bottom: 50rpx;
  padding: 40rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.admin-welcome-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 20rpx;
  animation: wave 2s ease-in-out infinite;
}

@keyframes wave {
  0%, 100% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(-20deg);
  }
  75% {
    transform: rotate(20deg);
  }
}

.admin-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.admin-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 400;
}

/* 密码验证区域 */
.password-section {
  margin-top: 60rpx;
}

/* 警告卡片 */
.warning-card {
  background: #fff3cd;
  border: 2rpx solid #ffc107;
  border-radius: 16rpx;
  padding: 30rpx 24rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 193, 7, 0.2);
}

.warning-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.warning-item:last-child {
  margin-bottom: 0;
}

.warning-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.warning-text {
  font-size: 26rpx;
  color: #856404;
  line-height: 1.5;
  flex: 1;
}

.warning-text.warning-error {
  color: #dc3545;
  font-weight: 500;
}

.password-input-wrapper {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.password-label {
  display: block;
  font-size: 32rpx;
  color: #334155;
  margin-bottom: 30rpx;
  font-weight: 500;
}

.password-input-container {
  position: relative;
  margin-bottom: 30rpx;
}

.password-input {
  width: 100%;
  height: 88rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 0 80rpx 0 24rpx;
  font-size: 32rpx;
  color: #1e293b;
  box-sizing: border-box;
}

.password-input:focus {
  border-color: #1296db;
  background: #fff;
}

.password-eye {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.eye-icon {
  font-size: 36rpx;
  opacity: 0.6;
}

.password-eye:active .eye-icon {
  opacity: 1;
}

.password-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1296db 0%, #0d7bb8 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.password-btn:active {
  opacity: 0.8;
}

/* 输入区域 */
.input-section {
  margin-top: 20rpx;
}

/* 欢迎横幅 */
.welcome-banner {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(245, 87, 108, 0.25);
  animation: fadeInDown 0.5s ease;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.welcome-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.welcome-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
}

.input-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 30rpx;
}

.input-label {
  margin-bottom: 20rpx;
}

.label-text {
  display: block;
  font-size: 32rpx;
  color: #1e293b;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.label-hint {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
}

.data-textarea {
  width: 100%;
  min-height: 300rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.6;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.data-textarea:focus {
  border-color: #1296db;
  background: #fff;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1296db 0%, #0d7bb8 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn:active {
  opacity: 0.8;
}

.submit-btn[disabled] {
  background: #e2e8f0 !important;
  color: #94a3b8 !important;
  opacity: 0.6;
}

.submit-btn:not([disabled]) {
  background: linear-gradient(135deg, #1296db 0%, #0d7bb8 100%) !important;
  color: #fff !important;
}

/* 结果卡片 */
.result-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.result-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-header.success {
  color: #10b981;
}

.result-header.error {
  color: #ef4444;
}

.result-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 500;
}

.result-content {
  padding-top: 20rpx;
  border-top: 2rpx solid #f1f5f9;
}

.result-message {
  display: block;
  font-size: 28rpx;
  color: #475569;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.result-detail {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.8;
  white-space: pre-line;
}
